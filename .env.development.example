# Copy to .env for local use. Replace every placeholder before deployment.
APP_ENV=development
APP_NAME=NOVA HOME API
DEBUG=true
SECRET_KEY=development-only-change-me-before-any-shared-use
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://nova:nova_dev_password@db:5432/nova_home
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Kashier sandbox. Obtain credentials from the Kashier developer dashboard.
KASHIER_ENV=test
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_MERCHANT_ID=
KASHIER_PAYMENT_TYPE=credit

# Meta WhatsApp Cloud API. Templates must be approved and recipients opted in.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WELCOME_TEMPLATE=welcome_customer
WHATSAPP_RECEIPT_TEMPLATE=order_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en

# OAuth providers: configure redirect URIs in each provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Frontend proxy target (inside Docker network).
API_INTERNAL_URL=http://api:8000
NUXT_PUBLIC_BRAND_NAME=NOVA HOME
POSTGRES_PASSWORD=nova_dev_password
REDIS_PASSWORD=local-redis-password
